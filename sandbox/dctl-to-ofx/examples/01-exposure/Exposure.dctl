DEFINE_UI_PARAMS(gain, Exposure Gain, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 5.0, 0.01)
DEFINE_UI_PARAMS(gamma, Gamma Adjust, DCTLUI_SLIDER_FLOAT, 1.0, 0.1, 3.0, 0.01)

DEFINE_UI_TOOLTIP(gain, "Linear exposure gain multiplier")
DEFINE_UI_TOOLTIP(gamma, "Power gamma response adjustment")

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float r = p_R * gain;
    float g = p_G * gain;
    float b = p_B * gain;

    r = _powf(_fmaxf(r, 0.0f), gamma);
    g = _powf(_fmaxf(g, 0.0f), gamma);
    b = _powf(_fmaxf(b, 0.0f), gamma);

    return make_float3(r, g, b);
}

