{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ciqueira/NexKeyRuntime/schemas/midi-device-profile.schema.json",
  "title": "MCNexus MIDI Device Profile",
  "description": "Hardware abstraction profile defining relative rotary encoder decoding and push switch click bindings for physical MIDI controllers in NexControl.",
  "type": "object",
  "required": [
    "profile_version",
    "vendor",
    "model",
    "match_port_name",
    "rotation_bindings"
  ],
  "additionalProperties": false,
  "properties": {
    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Schema version (currently 1)."
    },
    "vendor": {
      "type": "string",
      "maxLength": 64,
      "description": "Hardware manufacturer name (e.g. 'DJ TechTools', 'MCNexus')."
    },
    "model": {
      "type": "string",
      "maxLength": 64,
      "description": "Hardware model designation (e.g. 'Midi Fighter Twister', 'Custom Rotary Controller')."
    },
    "match_port_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Deterministic case-insensitive substring used to associate connected MIDI ports with this profile."
    },
    "rotation_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/rotation_binding"
      }
    },
    "click_bindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/click_binding"
      }
    }
  },
  "$defs": {
    "rotation_binding": {
      "type": "object",
      "required": [
        "cc_start",
        "cc_end",
        "param_offset"
      ],
      "additionalProperties": false,
      "properties": {
        "bank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 0,
          "description": "Logical bank number (0 if unbanked, or 1..4)."
        },
        "midi_channel": {
          "type": "integer",
          "minimum": -1,
          "maximum": 16,
          "default": -1,
          "description": "MIDI channel 1..16, or -1 for wildcard (matches any channel)."
        },
        "encoder_mode": {
          "type": "string",
          "enum": [
            "twos_complement",
            "binary_offset_64"
          ],
          "default": "twos_complement",
          "description": "Mathematical relative encoding format."
        },
        "step_sensitivity": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 1.0,
          "default": 0.01,
          "description": "Multiplier per tick applied to the OFX parameter normalized scale."
        },
        "cc_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "First Control Change number in contiguous range."
        },
        "cc_end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "Last Control Change number in contiguous range (must be >= cc_start)."
        },
        "param_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Target OFX parameter index offset corresponding to cc_start."
        }
      }
    },
    "click_binding": {
      "type": "object",
      "required": [
        "type",
        "index_start",
        "index_end",
        "param_offset",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "note_on",
            "cc_value"
          ],
          "description": "Message type used to signal the push-switch / button click."
        },
        "midi_channel": {
          "type": "integer",
          "minimum": -1,
          "maximum": 16,
          "default": -1,
          "description": "MIDI channel 1..16, or -1 for wildcard."
        },
        "index_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "Starting CC number or Note number."
        },
        "index_end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "Ending CC number or Note number (>= index_start)."
        },
        "param_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Target OFX parameter index offset corresponding to index_start."
        },
        "trigger_values": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "description": "Values that trigger the click (for cc_value type; empty for note_on with velocity > 0)."
        },
        "action": {
          "type": "string",
          "enum": [
            "reset_default",
            "toggle_bool"
          ],
          "default": "reset_default",
          "description": "Action executed on trigger: reset_default restores default_val, toggle_bool inverts booleans."
        }
      }
    }
  }
}
